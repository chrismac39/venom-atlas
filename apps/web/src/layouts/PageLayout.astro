---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isAtlasRoute = normalizedPath === '/' || normalizedPath === '/atlas';
const atlasSectionLinks = [
  { href: '/#section-organism-profile', label: 'Profile' },
  { href: '/#section-geography', label: 'Geography' },
  { href: '/#section-mechanisms', label: 'Mechanisms' },
  { href: '/#section-toxin-categorization', label: 'Categorization' },
  { href: '/#section-toxin-charts', label: 'Charts' },
  { href: '/#section-chemistry', label: 'Chemistry' },
  { href: '/#section-human-physiology', label: 'Human Physiology' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
  </head>
  <body>
    <nav class="primary" aria-label="Main navigation">
      <a href="/">Venom Atlas</a>
      {isAtlasRoute
        ? atlasSectionLinks.map((link) => <a href={link.href}>{link.label}</a>)
        : null}
      <a href="/organisms">Organisms</a>
      <a href="/toxins">Toxins</a>
      <a href="/effects">Effects</a>
      <a href="/sources">Sources</a>
      <a href="/about">About</a>
      <slot name="theme" />
    </nav>
    <main>
      <slot />
    </main>
    <script is:inline>
      (() => {
        const nav = document.querySelector('nav.primary');
        if (!nav) {
          return;
        }

        const syncTopRibbonHeight = () => {
          const navHeight = Math.ceil(nav.getBoundingClientRect().height);
          if (navHeight > 0) {
            document.documentElement.style.setProperty('--top-ribbon-height', `${navHeight}px`);
          }
        };

        syncTopRibbonHeight();
        window.addEventListener('resize', syncTopRibbonHeight);

        if ('ResizeObserver' in window) {
          const resizeObserver = new ResizeObserver(syncTopRibbonHeight);
          resizeObserver.observe(nav);
        }
      })();
    </script>
  </body>
</html>
