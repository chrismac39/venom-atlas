---
import PageLayout from '../layouts/PageLayout.astro';
import { appPath } from '../lib/paths';
import { ThemeSwitcher } from '../islands/ThemeSwitcher';
import { buildAtlasMonopageOrganisms } from '../lib/atlas-monopage-data';
import { toxicStrategyLabel } from '../lib/organism-labels';

const organisms = buildAtlasMonopageOrganisms();
---

<PageLayout title="Venom Atlas" description="Choose an organism and explore its venom, chemistry, geography, and physiological effects.">
  <ThemeSwitcher slot="theme" client:idle />
  <section class="atlas-chooser" aria-labelledby="atlas-chooser-title">
    <header class="atlas-chooser-intro">
      <p class="atlas-chooser-kicker">One organism. The complete venom story.</p>
      <h1 id="atlas-chooser-title">Choose an organism to explore</h1>
      <p>
        Follow the evidence from natural history and geographic range through venom chemistry,
        delivery mechanisms, and effects on the human body.
      </p>
    </header>

    {organisms.length === 0 && (
      <p role="status">No organism dossiers currently meet the publication requirements. The atlas remains available while source material is prepared. <a href={appPath('/about')}>About the atlas</a></p>
    )}
    <ul class="atlas-chooser-grid" aria-label="Available organisms">
      {organisms.map((organism) => {
        return (
          <li>
            <a class="atlas-chooser-option" href={appPath(`/atlas/${organism.slug}`)}>
              <span class="atlas-specimen-mark" aria-hidden="true">
                <span>{organism.taxonomy.genus?.slice(0, 1)}</span>
                <span>{organism.taxonomy.species?.split(' ')[1]?.slice(0, 1)}</span>
                <small>{organism.taxonomy.family}</small>
              </span>
              <span class="atlas-chooser-option-copy">
                <span class="atlas-chooser-common-name">{organism.commonName}</span>
                <span class="atlas-chooser-scientific-name"><i>{organism.scientificName}</i></span>
                <span class="atlas-chooser-type">
                  {organism.taxonomy.className ?? 'Unclassified'} · {toxicStrategyLabel(organism.toxicStrategy)}
                </span>
                <span class="atlas-chooser-summary">{organism.overview}</span>
                <span class="atlas-chooser-action">Explore organism <span aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</PageLayout>
