---
import PageLayout from '../../../layouts/PageLayout.astro';
import EvidenceBadge from '../../../components/astro/EvidenceBadge.astro';
import CitationList from '../../../components/astro/CitationList.astro';
import { ThemeSwitcher } from '../../../islands/ThemeSwitcher';
import { MoleculeViewer } from '../../../molecular/components/MoleculeViewer';
import type { MolecularRepresentation } from '@venom-atlas/visualization-contracts';
import { getAllToxins, getCitationsByIds, getOrganismSlugByToxinSlug, getToxinBySlug } from '../../../lib/content';
import { pickPreferred3dAsset, pickPreferred2dAsset } from '../../../lib/structure-assets';
import { appPath } from '../../../lib/paths';

const supportedRepresentations: MolecularRepresentation[] = [
  'ball_and_stick',
  'stick',
  'space_filling',
  'molecular_surface',
];

export const getStaticPaths = async () => {
  return getAllToxins().map((entry) => ({
    params: { slug: entry.toxin.slug },
  }));
};

const { slug } = Astro.params;
const toxinBundle = slug ? getToxinBySlug(slug) : undefined;
const organismSlug = slug ? getOrganismSlugByToxinSlug(slug) : undefined;
const atlasBaseHref = organismSlug ? `/atlas/${organismSlug}` : '/';

if (!toxinBundle) {
  throw new Error(`Missing toxin bundle for slug: ${slug}`);
}

const structureAsset = pickPreferred3dAsset(toxinBundle.structureAssets);
const structure2d = pickPreferred2dAsset(toxinBundle.structureAssets);
const structureFormat =
  structureAsset && structureAsset.format !== 'svg' ? structureAsset.format : undefined;
const model = {
  entityId: toxinBundle.molecularEntity.id,
  displayName: toxinBundle.molecularEntity.displayName,
  molecularClass: toxinBundle.molecularEntity.molecularClass,
  structureFormat,
  structureUrl: structureAsset?.localPath ? appPath(structureAsset.localPath) : undefined,
  structure2dUrl: structure2d?.localPath ? appPath(structure2d.localPath) : undefined,
  defaultRepresentation: 'ball_and_stick' as MolecularRepresentation,
  supportedRepresentations,
  annotations: [
    {
      id: 'ann-scaffold-warning',
      label: 'Scaffold caution',
      description: 'Representation is educational; unresolved fields remain unsourced.',
    },
  ],
};

const citations = getCitationsByIds(toxinBundle.molecularEntity.evidence.citationIds);
---

<PageLayout title={`${toxinBundle.toxin.displayName} | Venom Atlas`} description="Molecular identity and structure evidence.">
  <ThemeSwitcher slot="theme" client:idle />

  <section class="panel">
    <h1>{toxinBundle.toxin.displayName}</h1>
    <EvidenceBadge evidence={toxinBundle.molecularEntity.evidence} />
    <p><strong>Molecular class:</strong> {toxinBundle.molecularEntity.molecularClass}</p>
    <p><strong>Formula:</strong> {toxinBundle.molecularEntity.formula ?? 'Data not yet sourced.'}</p>
    <p>
      <strong>Molecular weight:</strong> {toxinBundle.molecularEntity.molecularWeight ?? 'Data not yet sourced.'}
    </p>
    <p>
      <strong>Structure-data source:</strong>{' '}
      {toxinBundle.molecularEntity.structureDataSource ?? 'Data not yet sourced.'}
    </p>
  </section>

  <MoleculeViewer client:visible model={model} />

  <section class="panel">
    <h2>2D structure panel</h2>
    {model.structure2dUrl ? (
      <img class="molecule-viewer-fallback" src={model.structure2dUrl} alt={`2D skeletal structure for ${model.displayName}`} />
    ) : <p>No 2D structure asset is available for this toxin.</p>}
  </section>

  <section class="panel">
    <h2>Evidence and sources</h2>
    <CitationList citations={citations} />
  </section>

  <section class="panel">
    <h2>Return to atlas</h2>
    <a href={appPath(`${atlasBaseHref}#section-chemistry`)}>Resume monopage at chemistry</a>
  </section>

</PageLayout>
