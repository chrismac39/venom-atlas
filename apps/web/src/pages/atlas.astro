---
import PageLayout from '../layouts/PageLayout.astro';
import { ThemeSwitcher } from '../islands/ThemeSwitcher';
import { AtlasMonopageIsland } from '../islands/AtlasMonopageIsland';
import { buildAtlasMonopageOrganisms } from '../lib/atlas-monopage-data';

const organisms = buildAtlasMonopageOrganisms();
---

<PageLayout title="Atlas Monopage | Venom Atlas" description="Continuous static-first monopage experience for organism-to-toxin exploration.">
  <ThemeSwitcher slot="theme" client:idle />
  <AtlasMonopageIsland client:load organisms={organisms} />
</PageLayout>
