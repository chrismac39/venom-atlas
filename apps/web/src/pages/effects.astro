---
import PageLayout from '../layouts/PageLayout.astro';
import { ThemeSwitcher } from '../islands/ThemeSwitcher';
import { getAllToxins, getMechanismByToxinSlug, getPhysiologyByToxinSlug } from '../lib/content';

const toxinEffects = getAllToxins().map((entry) => {
  const slug = entry.toxin.slug ?? '';
  return {
    toxin: entry.toxin,
    mechanism: getMechanismByToxinSlug(slug),
    physiology: getPhysiologyByToxinSlug(slug),
  };
});
---

<PageLayout title="Effects | Venom Atlas" description="Mechanism and physiology overview by toxin.">
  <ThemeSwitcher slot="theme" client:idle />
  <section class="panel">
    <h1>Effects Overview</h1>
    <p class="muted">Ordered mechanism and physiology pathways grouped by toxin.</p>
  </section>

  {toxinEffects.map((entry) => (
    <section class="panel">
      <h2>{entry.toxin.displayName}</h2>
      <p><strong>Family:</strong> {entry.toxin.family ?? 'Not yet sourced'}</p>
      <p>
        <a href={`/toxins/${entry.toxin.slug}/mechanism`}>Mechanism page</a> |{' '}
        <a href={`/toxins/${entry.toxin.slug}/physiology`}>Physiology page</a>
      </p>
      <p><strong>Mechanism steps:</strong> {entry.mechanism?.steps.length ?? 0}</p>
      <p><strong>Physiology effects:</strong> {entry.physiology?.effects.length ?? 0}</p>
    </section>
  ))}
</PageLayout>
