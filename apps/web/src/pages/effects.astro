---
import PageLayout from '../layouts/PageLayout.astro';
import EvidenceBadge from '../components/astro/EvidenceBadge.astro';
import { ThemeSwitcher } from '../islands/ThemeSwitcher';
import {
  getAllOrganisms,
  getMechanismByOrganismExposureSlug,
  getPhysiologyByOrganismExposureSlug,
} from '../lib/content';

const exposureEffects = getAllOrganisms().flatMap((entry) => {
  const slug = entry.organism.slug;
  if (!slug) return [];

  return {
    organism: entry.organism,
    mechanism: getMechanismByOrganismExposureSlug(slug),
    physiology: getPhysiologyByOrganismExposureSlug(slug),
  };
}).filter((entry) => entry.mechanism || entry.physiology);
---

<PageLayout title="Effects | Venom Atlas" description="Observed effects grouped by organism exposure.">
  <ThemeSwitcher slot="theme" client:idle />
  <section class="panel">
    <h1>Effects Overview</h1>
    <p class="muted">
      Exposure evidence is grouped by organism. Effects are not attributed to an isolated compound unless the
      underlying source supports that claim.
    </p>
  </section>

  {exposureEffects.map((entry) => (
    <section class="panel">
      <h2>{entry.organism.commonName}</h2>
      <p><em>{entry.organism.scientificName}</em></p>
      <h3>Exposure progression</h3>
      <ol>
        {entry.mechanism?.steps.map((step) => (
          <li>
            <strong>{step.title}</strong>: {step.description} <EvidenceBadge evidence={step.evidence} />
          </li>
        ))}
      </ol>
      <h3>Reported physiological effects</h3>
      <ul>
        {entry.physiology?.effects.map((effect) => (
          <li>
            <strong>{effect.title}</strong>: {effect.description} <EvidenceBadge evidence={effect.evidence} />
          </li>
        ))}
      </ul>
      <a href={`/atlas/${entry.organism.slug}#section-human-physiology`}>Open the complete exposure dossier</a>
    </section>
  ))}
</PageLayout>
