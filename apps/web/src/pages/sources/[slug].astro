---
import PageLayout from '../../layouts/PageLayout.astro';
import { appPath } from '../../lib/paths';
import { ThemeSwitcher } from '../../islands/ThemeSwitcher';
import { getCitationBySlug, getPublicCitations, getPublicClaimReferencesByCitationId } from '../../lib/content';

export const getStaticPaths = async () => {
  return getPublicCitations().flatMap((citation) =>
    [citation.slug, ...(citation.aliases ?? [])].map((slug) => ({ params: { slug } })),
  );
};

const { slug } = Astro.params;
const citation = slug ? getCitationBySlug(slug) : undefined;

if (!citation) {
  throw new Error(`Unknown citation slug: ${slug}`);
}
if (slug !== citation.slug) {
  return Astro.redirect(appPath(`/sources/${citation.slug}`), 301);
}
const claimReferences = getPublicClaimReferencesByCitationId(citation.id);
---

<PageLayout title={`${citation.title} | Sources | Venom Atlas`} description="Citation detail page.">
  <ThemeSwitcher slot="theme" client:idle />
  <section class="panel">
    <h1>{citation.title}</h1>
    <p><strong>Source type:</strong> {citation.sourceType}</p>
    <p><strong>Publisher:</strong> {citation.publisher ?? 'Unspecified'}</p>
    <p><strong>Authors:</strong> {citation.authors?.join(', ') || 'Unspecified'}</p>
    <p><strong>Publication year:</strong> {citation.publicationYear ?? 'Unspecified'}</p>
    <p><strong>DOI:</strong> {citation.doi ?? 'Unspecified'}</p>
    <p><strong>Accessed:</strong> {citation.accessedAt ?? 'Unspecified'}</p>
    {citation.url ? (
      <p>
        <a href={citation.url} target="_blank" rel="noreferrer">Open source</a>
      </p>
    ) : (
      <p class="muted">Source URL unavailable.</p>
    )}
    <h2>Cited by claims</h2>
    {claimReferences.length ? (
      <ul>
        {claimReferences.map((reference) => (
          <li><a href={appPath(reference.route)}>{reference.label}</a> ({reference.subjectLabel})</li>
        ))}
      </ul>
    ) : (
      <p class="muted">No published structured claims currently cite this source.</p>
    )}
    <p><a href={appPath('/sources')}>Back to all sources</a></p>
  </section>
</PageLayout>
