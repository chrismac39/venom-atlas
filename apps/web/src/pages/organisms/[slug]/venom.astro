---
import { getAllOrganisms, getToxicMaterialByOrganismSlug } from '../../../lib/content';

export const getStaticPaths = async () => {
  return getAllOrganisms()
    .filter((entry) => {
      const material = getToxicMaterialByOrganismSlug(entry.organism.slug ?? '');
      return material?.toxicMaterial.materialKind === 'venom';
    })
    .map((entry) => ({ params: { slug: entry.organism.slug } }));
};

return Astro.redirect(`/organisms/${Astro.params.slug}/toxic-material`, 301);
