---
import PageLayout from '../../../layouts/PageLayout.astro';
import { ThemeSwitcher } from '../../../islands/ThemeSwitcher';
import { RangeMapPanel } from '../../../visualizations/maps/RangeMapPanel';
import { getAllOrganisms, getOrganismBySlug, getGeographyByOrganismSlug } from '../../../lib/content';

export const getStaticPaths = async () => {
  return getAllOrganisms()
    .filter((entry) => getGeographyByOrganismSlug(entry.organism.slug ?? '') !== undefined)
    .map((entry) => ({ params: { slug: entry.organism.slug } }));
};

const { slug } = Astro.params;
const organism = slug ? getOrganismBySlug(slug) : undefined;
const geography = slug ? getGeographyByOrganismSlug(slug) : undefined;

if (!organism || !geography) {
  throw new Error(`Missing organism/geography for slug: ${slug}`);
}

const atlasHref = `/atlas/${organism.organism.slug}#section-geography`;
---

<PageLayout title={`${organism.organism.scientificName} geography | Venom Atlas`} description="Ecology and range data.">
  <ThemeSwitcher slot="theme" client:idle />
  <section class="panel">
    <h1>Ecology and geography</h1>
    <p>Source-backed occurrence records are shown separately from modeled range boundaries.</p>
  </section>

  <RangeMapPanel ranges={geography.ranges} />

  <section class="panel">
    <h2>Return to atlas</h2>
    <a href={atlasHref}>Resume monopage at geography</a>
  </section>

</PageLayout>
