---
import PageLayout from '../../layouts/PageLayout.astro';
import { ThemeSwitcher } from '../../islands/ThemeSwitcher';
import { getAllOrganisms } from '../../lib/content';

const organisms = getAllOrganisms().sort((a, b) =>
  a.organism.scientificName.localeCompare(b.organism.scientificName),
);
---

<PageLayout title="Organisms | Venom Atlas" description="Browse organisms in Venom Atlas.">
  <ThemeSwitcher slot="theme" client:idle />
  <section class="panel">
    <h1>Organisms</h1>
    <ul>
      {organisms.map((entry) => (
        <li>
          <a href={`/organisms/${entry.organism.slug}`}>{entry.organism.scientificName}</a> ({entry.organism.commonName})
        </li>
      ))}
    </ul>
  </section>
</PageLayout>
