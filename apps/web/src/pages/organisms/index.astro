---
import PageLayout from '../../layouts/PageLayout.astro';
import { ThemeSwitcher } from '../../islands/ThemeSwitcher';
import { buildAtlasMonopageOrganisms } from '../../lib/atlas-monopage-data';
import { OrganismCatalogIsland } from '../../islands/OrganismCatalogIsland';

const organisms = buildAtlasMonopageOrganisms();
---

<PageLayout title="Organisms | Venom Atlas" description="Browse organisms in Venom Atlas.">
  <ThemeSwitcher slot="theme" client:idle />
  <OrganismCatalogIsland client:load organisms={organisms} />
</PageLayout>
