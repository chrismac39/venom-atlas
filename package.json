{
  "name": "venom-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive scientific atlas for venomous and poisonous organisms.",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @venom-atlas/web dev",
    "dev:api": "pnpm --filter @venom-atlas/api dev",
    "db:up": "docker compose up -d clickhouse",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @venom-atlas/api db:migrate",
    "db:seed": "pnpm --filter @venom-atlas/api db:seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @venom-atlas/web test:e2e",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
